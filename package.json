{
  "name": "huangxiaoshuai",
  "version": "1.0.0",
  "author": "Huang Xiaoshuai",
  "description": "黄小帅麻辣鸡外卖订单管理平台",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "vite",
    "server": "node --no-deprecation server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:api": "node tests/run-all.js",
    "test:e2e": "node tests/e2e/00_smoke.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop huang-server huang-frontend",
    "pm2:restart": "pm2 restart huang-server huang-frontend",
    "pm2:delete": "pm2 delete huang-server huang-frontend",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "pm2:setup": "pm2 startup && pm2 save"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vue/shared": "^3.5.40",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "element-plus": "^2.6.1",
    "express": "^4.18.2",
    "pinia": "^2.3.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "pm2": "^7.0.3",
    "vite": "^5.1.5"
  }
